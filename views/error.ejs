<%- include('partials/header') %>
<section class="empty-state error-page"><span class="error-code" aria-hidden="true"><%= status %></span><p class="eyebrow">A pause, not the end of the road</p><h1><% if (status === 404) { %>This pair of paths didn’t meet.<% } else if (status === 403) { %>Let’s refresh your next step.<% } else if (status === 409) { %>Time for a fresh review.<% } else { %>Something needs another look.<% } %></h1><p><%= message %></p><%- include('partials/errors') %><div class="error-actions"><a class="button button-dark" href="/products">Back to the collection</a><% if (status === 409) { %><a class="button button-outline" href="/checkout">Review your bag again</a><% } else { %><a class="button button-outline" href="/cart">Check your bag</a><% } %></div></section>
<%- include('partials/footer') %>
